	(uuid "78a2b5d5-e440-5a06-8650-1771688da222")
	(paper "A3")
	(title_block
		(title "DUART SC26C92, bit-bang SPI, DS3234, NIC header")
		(date "2026-09-26")
		(rev "A (draft)")
		(company "Matthew Bettcher — 68030 Linux SBC")
		(comment 1 "U6 pinout: Philips SC26C92 datasheet (2000-01) Fig. 1 PLCC column, not DIP/PQFP")
		(comment 2 "Pin 12 is NC (SC28L92 I/M). Left open so an SC28L92 in the same socket is Intel mode")
		(comment 3 "2 wait states unchanged (DUART_WS=2, DUART_DLY=0). No glue refit")
		(comment 4 "DS3234 Maxim 19-5339: NC pins to GND, both SCLK pins tied, no diode in series with VBAT")
	)
