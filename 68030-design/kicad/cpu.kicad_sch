	(text "CPU decoupling: 10x 100 nF (one per VCC pin, under the socket), 4x 330 pF C0G, 2x 10 uF X7R, 1x 220 uF low-ESR within 20 mm"
		(exclude_from_sim no)
		(at 132.08 213.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a6a245ea-a104-5089-a23a-238e83dcec40")
	)
	(text "HEATSINK: MC68030 dissipates up to 2.6 W (EC); theta-JA ~30 C/W (PGA, EC estimate) -> up to +78 C rise.\nFit a stick-on PGA heatsink (HS1), mandatory for 33 MHz operation."
		(exclude_from_sim no)
		(at 132.08 254 0)
		(effects
