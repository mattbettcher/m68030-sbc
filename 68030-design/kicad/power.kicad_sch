	(text "Input: 9-24 V DC barrel jack (centre +), T5A fuse, P-FET reverse-polarity protection, TVS"
		(exclude_from_sim no)
		(at 25.4 50.8 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "58f6dcd1-ee63-5172-9215-b73af171a6ba")
	)
	(text "C201-C203: 50 V X7R 1210\nC204: 50 V electrolytic"
		(exclude_from_sim no)
		(at 137.16 93.98 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "9782b50b-34a9-524a-90ab-d4127d0b89e2")
	)
	(text "Q1: body diode conducts first, then Vgs = -(VIN) turns the channel on;\nreversed input leaves Q1 off. D3 clamps |Vgs| to 12 V (Q1 Vgs max +/-20 V).\nD2 SMBJ28CA: bidirectional TVS, 28 V standoff; clamp at rated Ipp (~45 V)\nis at the LM2678 45 V abs-max [EST] - fuse F1 clears sustained faults."
		(exclude_from_sim no)
		(at 25.4 111.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b4706d8e-50ce-58fe-9528-38158f9dc791")
	)
	(text "C201-C204: Irms rating must exceed Iload/2 = 2 A (SNVS029L step 5).\nDeviation from Table 7-7 (tantalum/aluminium): 3x 10 uF 50 V X7R 1210 +\n1x 100 uF 50 V low-ESR electrolytic for bulk/damping on hot-plug."
		(exclude_from_sim no)
		(at 25.4 129.54 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b0050bba-7b6e-5282-824e-b1e7de55c413")
	)
	(text "5 V buck: LM2678S-5.0 (fixed 5 V, 260 kHz, 5 A switch)"
		(exclude_from_sim no)
		(at 190.5 50.8 0)
		(effects
