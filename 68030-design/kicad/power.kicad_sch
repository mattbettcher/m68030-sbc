	(text "C206-C208: 100 uF 10 V\ntantalum (T495-X)"
		(exclude_from_sim no)
		(at 264.16 96.52 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "ad36912b-7ae9-5d86-b10a-8effa847501f")
	)
	(text "L1: Fig 7-3 nomograph (5 V, 24 V, 4 A) -> L41 = 22 uH; SRP1770TA-220M: DCR 26.5 mOhm, Isat 18 A.\nC206-C208: Table 7-5 -> 3x AVX/KEMET 100 uF 10 V 'C4' tantalum (no all-ceramic output).\nD1: Schottky, VR >= 1.3 x 24 V, IF >= 5 A (Table 7-4 class) -> B540C (40 V, 5 A).\nC205 (CB): 0.01 uF per step 7 / sect. 7.1.6 (pin table says 100 nF - see NOTES.md).\nOutput: 4.85-5.15 V over line/load/temp (SNVS029L electrical table).\nSJ201: ON/OFF (pin 7) left open = enabled (abs max 6 V, never tie to VIN); bridge to disable.\nJP202: cut to isolate the buck and feed +5V from J3 (bench supply). J3 DNP."
		(exclude_from_sim no)
		(at 190.5 111.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "77460cd5-9ef5-51a9-96bd-95548bbefb62")
	)
	(text "3.3 V LDO for DS3234 RTC / ENC28J60 / logic-level parts (spec 6.1)"
		(exclude_from_sim no)
		(at 25.4 147.32 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "6d9cef4c-3faa-5a09-bfde-dc7e91325dff")
	)
	(text "C210: AMS1117 datasheet 'Stability': 22 uF solid tantalum on the output covers all conditions.\nC209: 10 uF input per the datasheet application circuit."
		(exclude_from_sim no)
		(at 25.4 187.96 0)
		(effects
			(font
